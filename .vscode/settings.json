{
  "[swift]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "swift.disableAutoResolve": true,
  "swift.backgroundCompilation": false,
  "search.exclude": {
    "build": true,
    "dist": true
  }
}
